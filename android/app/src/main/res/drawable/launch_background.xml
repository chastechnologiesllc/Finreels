<?xml version="1.0" encoding="utf-8"?>
<!-- Background shown before Flutter engine initialises.
     Reads @color/launch_background which is defined per resource-qualifier:
       values/         → #FFFFFF  (light / default)
       values-night/   → #000000  (dark mode)
     This means the pre-Flutter frame matches the user's system theme exactly,
     eliminating the jarring white→black (or black→white) flash on first launch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
