<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── LIGHT MODE (day qualifier) ────────────────────────────────────────
         LaunchTheme: shown from process start until Flutter's first frame.
         Parent = Theme.Light so Android defaults the window background to
         white, matching our @color/launch_background override and AppTheme.lightBg.
         windowLightStatusBar=true → dark status-bar icons on light bg. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
    </style>

    <!-- NormalTheme: applied after Flutter takes over. Uses the system's own
         window background colour so no extra flash between themes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
    </style>
</resources>
