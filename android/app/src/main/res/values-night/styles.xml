<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── DARK MODE (night qualifier) ───────────────────────────────────────
         LaunchTheme: shown from process start until Flutter's first frame.
         Parent = Theme.Black so Android defaults the window to black,
         matching our @color/launch_background (night) and AppTheme.darkBg.
         windowLightStatusBar=false → light status-bar icons on dark bg. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
    </style>

    <!-- NormalTheme: applied after Flutter takes over. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
    </style>
</resources>
